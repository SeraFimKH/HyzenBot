# Discord Developer Portal (discord.com/developers/applications) — Bot tab for the token, General Information
# tab for the application/client id, OAuth2 tab if you need to (re)generate the invite URL.
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Optional: set to a single server's id to register slash commands instantly there instead of globally
# (global registration can take up to an hour to propagate — use this while developing).
DISCORD_GUILD_ID=

# Same Postgres instance every Hyzen plugin already points at (see plugins/HyzenCore/config.yml) — used only
# by the /verificar auth flow (database/auth.js, database/pool.js). Everything else (tickets, Pix, raffles,
# polls, invites, config) uses the local JSON files in data/ instead (see database/jsonStore.js).
PGHOST=localhost
PGPORT=5432
PGDATABASE=hyzen_network
PGUSER=hyzen
PGPASSWORD=hyzen

# Optional — /pix works in mock/test mode without this (fake QR code, auto-approves). Set a real Mercado Pago
# access token here for a network-wide default, or per-guild via /config pagamento (which takes priority).
MERCADOPAGO_ACCESS_TOKEN=

# Optional — /config ia-ativar needs an API key configured (globally here, or per-guild via /config ia-chave,
# which takes priority). Works with any provider compatible with OpenAI's chat-completions format (OpenAI,
# Groq, OpenRouter, DeepSeek, a local Ollama, etc) — set the base URL/model per-guild via /config ia-chave too.
OPENAI_API_KEY=

# Same Redis every HyzenCore instance writes cross-server presence to (see RedisManager#writePresence in
# HyzenCore) — used by /perfil's online/offline status and by the server status (the hyzen:server:* heartbeats
# each HyzenCore keeps there, see services/serverStatus.js). Defaults match plugins/HyzenCore/config.yml.
REDISHOST=localhost
REDISPORT=6379
REDISPASSWORD=

# Optional — the site's address (HyzenWeb), for the links in the reports channel (the report's page in the admin and
# its proof). Defaults to https://hyzen.com.br.
SITE_URL=
